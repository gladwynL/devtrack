# Template for a real deployment's environment variables. Copy the values
# you need into your hosting platform's own secret/env store (Render,
# Railway, Fly.io, etc.) — do NOT create a committed .env.production file.
#
# Differences from .env.example that matter for production:
#   - ENVIRONMENT must be exactly "production". The backend refuses to start
#     if ENVIRONMENT=production and JWT_SECRET_KEY is still the built-in
#     insecure default (see app/core/config.py).
#   - DEBUG must be false (the default) so FastAPI doesn't return debug
#     tracebacks to clients.
#   - CORS_ORIGINS must list only your real deployed frontend origin(s),
#     as an exact scheme+host(+port) match — never "*".
#   - DATABASE_URL comes from your managed PostgreSQL provider. A bare
#     "postgres://" or driver-less "postgresql://" URL is fine — the app
#     normalizes it to the psycopg2 driver it has installed.

DATABASE_URL=postgresql://user:password@your-db-host:5432/devtrack

ENVIRONMENT=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Your deployed frontend's exact origin(s), as a JSON array.
CORS_ORIGINS=["https://your-frontend-domain.example"]

# --- Frontend build-time variable (set where the frontend is built, e.g.
# Render's static-site env vars, not here) ---
# VITE_API_BASE_URL=https://your-backend-domain.example
