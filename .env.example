# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file.

# --- PostgreSQL (used by docker-compose.yml and the backend) ---
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=devtrack
POSTGRES_DB=devtrack
POSTGRES_PORT=5432

# --- Backend ---
# Must match the PostgreSQL settings above when running against Docker Compose.
DATABASE_URL=postgresql+psycopg2://devtrack:devtrack@localhost:5432/devtrack
ENVIRONMENT=development
DEBUG=true

# --- Authentication (JWT) ---
# Generate a real secret for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the app's built-in development default outside local dev.
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
