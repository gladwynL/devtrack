# Copy this file to .env and adjust values for your local environment.
# Never commit the real .env file. For a production-style deployment, see
# .env.production.example instead.

# --- PostgreSQL (used by docker-compose.yml and the backend) ---
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=devtrack
POSTGRES_DB=devtrack
POSTGRES_PORT=5432

# --- Backend ---
# Must match the PostgreSQL settings above when running against Docker Compose.
DATABASE_URL=postgresql+psycopg2://devtrack:devtrack@localhost:5432/devtrack
ENVIRONMENT=development
DEBUG=true
# JSON array of allowed frontend origins. Includes both the Vite dev
# server (5173) and the full docker-compose stack's nginx-served frontend
# (8080), so this one value works for either local setup.
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Authentication (JWT) ---
# Generate a real secret for any non-local environment, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the app's built-in development default outside local dev.
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Full docker-compose stack (postgres + backend + frontend) ---
# Only read by docker-compose.yml itself, not by the app directly.
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Backend URL as reachable from the browser (not the Docker network) —
# baked into the frontend's JS bundle at build time. See frontend/Dockerfile.
FRONTEND_API_BASE_URL=http://localhost:8000
